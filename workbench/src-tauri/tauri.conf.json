{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STARDROP Workbench",
  "version": "0.1.0",
  "identifier": "com.yildizroket.stardrop-workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run prepare:toolchain",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STARDROP Workbench",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["toolchain/"],
    "category": "DeveloperTool",
    "shortDescription": "STARDROP STM32 hardware validation workbench"
  }
}
